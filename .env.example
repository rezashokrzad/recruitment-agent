# ─────────────────────────────────────────────────────────────
#  Copy this file to .env.local and fill in the values.
#  .env.local is gitignored — never commit real secrets.
# ─────────────────────────────────────────────────────────────

# ── LLM: DeepSeek served through AvalAI (the ONLY LLM in this project) ──
AVALAI_API_KEY=
AVALAI_BASE_URL=https://api.avalai.ir/v1
LLM_MODEL=deepseek-chat

# ── Google (service account) ──
# The service account email must be:
#   • an Editor on the Google Sheet
#   • given "Make changes to events" on the manager's calendar
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Paste the private_key from the JSON key file, in double quotes, with literal \n.
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# The long id in the sheet URL: docs.google.com/spreadsheets/d/<SHEET_ID>/edit
SHEET_ID=

# ── Manager & interview ──
MANAGER_CALENDAR_ID=
MANAGER_TIMEZONE=Asia/Tehran
MANAGER_NAME=
MANAGER_EMAIL=
INTERVIEW_LOCATION=

# ── Email (Resend) ──
RESEND_API_KEY=
# Must be on a domain verified in Resend. onboarding@resend.dev works for testing
# but only delivers to the email address of your own Resend account.
EMAIL_FROM="استخدام <onboarding@resend.dev>"
SEND_REJECTION_EMAILS=false
SEND_RECEIPT_EMAILS=true

# ── Resume uploads ──
RESUME_STORAGE_DIR=./storage/resumes
MAX_RESUME_MB=5
SCREEN_ON_UPLOAD=true

# ── Scheduler ──
SLOT_STEP_MINUTES=15
MIN_LEAD_HOURS=24
SEARCH_WEEKS=6

# ── Security ──
# Password for /admin (min 8 chars). Changing it logs everyone out.
ADMIN_PASSWORD=
# Sent as the "x-cron-secret" header to POST /api/screen (min 16 chars).
CRON_SECRET=
